@startuml
left to right direction
skinparam packageStyle rectangle

' Actors
actor "Customer" as cust
actor "Admin" as admin
actor "Payment Gateway" as pg <<System>>

' System Boundary
rectangle "E-Commerce System" {
    usecase "Register / Login" as UC_Login
    usecase "Browse Products" as UC_Browse
    usecase "Add to Cart" as UC_Cart
    usecase "Checkout" as UC_Checkout
    usecase "Make Payment" as UC_Pay
    usecase "Apply Discount Code" as UC_Discount
    usecase "Manage Products" as UC_Manage
}

' Relations
cust --> UC_Login
cust --> UC_Browse
cust --> UC_Cart
cust --> UC_Checkout

UC_Checkout ..> UC_Pay : <<include>>
UC_Discount ..> UC_Checkout : <<extend>>

UC_Pay --> pg
admin --> UC_Manage
admin --|> cust : Inherits

@enduml